<div class="collection-page-wrapper">
  <!-- Collection Hero -->
  <div class="collection-hero">
    <div class="page-width">
      <h1 class="collection-hero__title">{{ collection.title | default: 'All Smart Finds' }}</h1>
      <p class="collection-hero__desc">{{ collection.description | default: 'Practical, high-utility home and gadget innovations engineered to solve everyday hassles.' }}</p>
    </div>
  </div>

  <div class="page-width" style="padding-top: 24px; padding-bottom: 64px;">
    <!-- Collection Toolbar: Filters & Sorting -->
    <div class="collection-toolbar">
      <div class="collection-filter-pills">
        <a href="#" class="filter-pill active" data-category="all">All Products</a>
        <a href="#" class="filter-pill" data-category="Gadgets">Gadgets</a>
        <a href="#" class="filter-pill" data-category="Kitchen">Kitchen Utility</a>
        <a href="#" class="filter-pill" data-category="Organisation">Home Organisation</a>
        <a href="#" class="filter-pill" data-category="Lighting">Lighting</a>
        <a href="#" class="filter-pill" data-category="Cleaning">Cleaning</a>
      </div>

      <div style="display: flex; align-items: center; gap: 8px;">
        <label for="collection-sort" style="font-size: 0.85rem; font-weight: 600; color: var(--color-text-muted);">Sort By:</label>
        <select id="collection-sort" class="sort-select">
          <option value="featured">Featured</option>
          <option value="best-selling">Best Selling</option>
          <option value="price-low-high">Price: Low to High</option>
          <option value="price-high-low">Price: High to Low</option>
        </select>
      </div>
    </div>

    <!-- Product Grid -->
    <div class="product-grid collection-grid">
      {% for product in collection.products %}
        {% render 'product-card', product_card_product: product %}
      {% else %}
        {% comment %} Fallback for sample preview {% endcomment %}
        {% for sample in section.settings.sample_products %}
          {% render 'product-card', product_card_product: sample %}
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collection Products",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 24,
      "step": 4,
      "default": 12,
      "label": "Products per page"
    }
  ]
}
{% endschema %}
