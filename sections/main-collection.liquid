<div class="collection-page-wrapper">
  <!-- Collection Hero -->
  <div class="collection-hero">
    <div class="page-width">
      <h1 class="collection-hero__title">{{ collection.title | default: 'All Smart Finds' }}</h1>
      <p class="collection-hero__desc">{{ collection.description | default: 'Practical, high-utility home and gadget innovations engineered to solve everyday hassles.' }}</p>
    </div>
  </div>

  <div class="page-width" style="padding-top: 24px; padding-bottom: 64px;">
    {% paginate collection.products by section.settings.products_per_page %}
      <!-- Collection Toolbar: Filters & Sorting -->
      <div class="collection-toolbar">
        <div class="collection-filter-pills">
          <a href="{{ routes.all_products_collection_url }}" class="filter-pill {% if collection.handle == 'all' %}active{% endif %}">All Products</a>
          <a href="{{ routes.collections_url }}/gadgets" class="filter-pill {% if collection.handle == 'gadgets' %}active{% endif %}">Gadgets</a>
          <a href="{{ routes.collections_url }}/kitchen" class="filter-pill {% if collection.handle == 'kitchen' %}active{% endif %}">Kitchen Utility</a>
          <a href="{{ routes.collections_url }}/home-organisation" class="filter-pill {% if collection.handle == 'home-organisation' %}active{% endif %}">Home Organisation</a>
          <a href="{{ routes.collections_url }}/lighting" class="filter-pill {% if collection.handle == 'lighting' %}active{% endif %}">Lighting</a>
          <a href="{{ routes.collections_url }}/cleaning" class="filter-pill {% if collection.handle == 'cleaning' %}active{% endif %}">Cleaning</a>
        </div>

        <div style="display: flex; align-items: center; gap: 8px;">
          <label for="collection-sort" style="font-size: 0.85rem; font-weight: 600; color: var(--color-text-muted);">Sort By:</label>
          <select id="collection-sort" class="sort-select" onchange="location.href = location.pathname + '?sort_by=' + this.value;">
            {% assign sort_by = collection.sort_by | default: collection.default_sort_by %}
            <option value="manual" {% if sort_by == 'manual' %}selected="selected"{% endif %}>Featured</option>
            <option value="best-selling" {% if sort_by == 'best-selling' %}selected="selected"{% endif %}>Best Selling</option>
            <option value="price-ascending" {% if sort_by == 'price-ascending' %}selected="selected"{% endif %}>Price: Low to High</option>
            <option value="price-descending" {% if sort_by == 'price-descending' %}selected="selected"{% endif %}>Price: High to Low</option>
            <option value="created-descending" {% if sort_by == 'created-descending' %}selected="selected"{% endif %}>Newest</option>
          </select>
        </div>
      </div>

      <!-- Product Grid -->
      <div class="product-grid collection-grid">
        {% for product in collection.products %}
          {% render 'product-card', product_card_product: product %}
        {% else %}
          <div style="grid-column: 1 / -1; text-align: center; padding: 60px 20px; color: var(--color-text-muted);">
            <div style="font-size: 3rem; margin-bottom: 12px;">📦</div>
            <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--color-primary); margin-bottom: 8px;">No products in this collection</h3>
            <p style="font-size: 0.95rem; margin-bottom: 20px;">Products will appear here once added to this collection in your Shopify Admin.</p>
            <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">View All Products</a>
          </div>
        {% endfor %}
      </div>

      <!-- Pagination -->
      {% if paginate.pages > 1 %}
        <div class="pagination-wrapper" style="text-align: center; margin-top: 40px;">
          {{ paginate | default_pagination }}
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</div>

{% schema %}
{
  "name": "Collection Products",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 24,
      "step": 4,
      "default": 12,
      "label": "Products per page"
    }
  ]
}
{% endschema %}
