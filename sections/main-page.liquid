<div class="static-page-wrapper">
  <div class="static-page-header">
    <div class="page-width">
      <h1>{{ page.title | default: 'About Bhaavzo' }}</h1>
    </div>
  </div>

  <div class="page-width">
    <div class="static-page-content">
      {{ page.content }}
    </div>

    {% for block in section.blocks %}
      {% case block.type %}
        {% when '@app' %}
          <div class="page-app-block" style="margin-top: 24px;" {{ block.shopify_attributes }}>
            {% render block %}
          </div>
      {% endcase %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Page Content",
  "settings": [],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
