{% assign deal_prod = all_products[section.settings.deal_product] %}
{% assign deal_variant = deal_prod.selected_or_first_available_variant %}

<section class="deal-section">
  <div class="page-width">
    <div class="deal-card">
      <div class="deal-grid">
        <div class="deal-info">
          <div class="deal__badge">
            <span>⚡ {{ section.settings.badge | default: 'Featured Deal' }}</span>
          </div>

          <h2 class="deal__title">
            {% if deal_prod != blank %}
              {{ deal_prod.title }}
            {% else %}
              {{ section.settings.title | default: 'Wireless Portable Blender (400ml)' }}
            {% endif %}
          </h2>

          <p class="deal__desc">
            {% if deal_prod != blank and deal_prod.description != blank %}
              {{ deal_prod.description | strip_html | truncate: 160 }}
            {% else %}
              {{ section.settings.description | default: 'Equipped with 6 ultra-sharp stainless steel blades, high-speed motor, and USB-C rechargeable battery. Crush fresh fruits and protein shakes on the go.' }}
            {% endif %}
          </p>

          <div style="display: flex; align-items: baseline; gap: 14px; margin-bottom: 24px;">
            <span style="font-size: 2rem; font-weight: 900; color: #FFFFFF;">
              {% if deal_variant != blank %}
                {{ deal_variant.price | money }}
              {% else %}
                ₹1,499
              {% endif %}
            </span>
            {% if deal_variant != blank and deal_variant.compare_at_price > deal_variant.price %}
              <span style="font-size: 1.2rem; color: #9FB3C8; text-decoration: line-through;">
                {{ deal_variant.compare_at_price | money }}
              </span>
              {% assign savings = deal_variant.compare_at_price | minus: deal_variant.price | times: 100 | divided_by: deal_variant.compare_at_price %}
              <span class="badge badge--sale" style="font-size: 0.85rem;">{{ savings }}% OFF</span>
            {% endif %}
          </div>

          <div style="display: flex; gap: 12px; flex-wrap: wrap;">
            {% if deal_variant != blank and deal_variant.available %}
              <button
                type="button"
                class="btn btn--primary btn--lg js-add-to-cart"
                data-variant-id="{{ deal_variant.id }}"
                data-id="{{ deal_variant.id }}"
                data-quantity="1"
              >
                ⚡ Add Deal to Cart
              </button>
            {% elsif deal_prod != blank %}
              <button type="button" class="btn btn--primary btn--lg" disabled="disabled" style="opacity: 0.6; cursor: not-allowed;">
                Sold Out
              </button>
            {% else %}
              <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary btn--lg">
                Explore Deals
              </a>
            {% endif %}

            {% if deal_prod != blank %}
              <a href="{{ deal_prod.url }}" class="btn btn--outline" style="border-color: rgba(255,255,255,0.4); color: #FFFFFF;">
                View Details
              </a>
            {% endif %}
          </div>
        </div>

        <div class="deal-visual">
          {% if deal_prod != blank and deal_prod.featured_image %}
            <img
              src="{{ deal_prod.featured_image | image_url: width: 600 }}"
              alt="{{ deal_prod.title | escape }}"
              class="deal-image"
              loading="lazy"
              width="500"
              height="500"
            >
          {% else %}
            <img
              src="https://images.unsplash.com/photo-1570831739435-6601aa3fa4fb?auto=format&fit=crop&w=600&q=80"
              alt="Wireless Portable Blender"
              class="deal-image"
              loading="lazy"
              width="500"
              height="500"
            >
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Deal of the Day",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "Featured Deal"
    },
    {
      "type": "product",
      "id": "deal_product",
      "label": "Featured Deal Product"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Fallback Deal Title",
      "default": "Wireless Portable Blender (400ml)"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Fallback Deal Description",
      "default": "Equipped with 6 ultra-sharp stainless steel blades, high-speed motor, and USB-C rechargeable battery. Crush fresh fruits and protein shakes on the go."
    }
  ],
  "presets": [
    {
      "name": "Deal of the Day"
    }
  ]
}
{% endschema %}
