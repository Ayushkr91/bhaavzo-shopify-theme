<section class="product-carousel-section">
  <div class="page-width">
    <div class="section-header">
      <div class="section-tagline">{{ section.settings.tagline | default: 'Top Rated by Customers' }}</div>
      <h2 class="section-title">{{ section.settings.title | default: 'Bhaavzo Best Sellers' }}</h2>
      <p class="section-subtitle">{{ section.settings.subtitle | default: 'Practical home and smart utility essentials carefully selected for modern Indian households.' }}</p>
    </div>

    <div class="product-grid">
      {% if section.settings.collection != blank and collections[section.settings.collection].products.size > 0 %}
        {% for product in collections[section.settings.collection].products limit: section.settings.products_to_show %}
          {% render 'product-card', product_card_product: product %}
        {% endfor %}
      {% else %}
        {% for product in collections.all.products limit: section.settings.products_to_show %}
          {% render 'product-card', product_card_product: product %}
        {% else %}
          <div style="grid-column: 1 / -1; text-align: center; padding: 40px; color: var(--color-text-muted);">
            Products will appear here once added to this collection.
          </div>
        {% endfor %}
      {% endif %}
    </div>

    <div style="text-align: center; margin-top: 40px;">
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--outline btn--lg">
        Explore All Products
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Best Sellers Carousel",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Top Rated by Customers"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Bhaavzo Best Sellers"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Practical home and smart utility essentials carefully selected for modern Indian households."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 2,
      "default": 8,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "Best Sellers Carousel"
    }
  ]
}
{% endschema %}
