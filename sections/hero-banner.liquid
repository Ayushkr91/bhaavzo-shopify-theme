<section class="hero-section" style="background: {{ section.settings.hero_bg }};">
  <div class="page-width">
    <div class="hero-grid">
      <div class="hero__content">
        <div class="hero__pill">
          <span class="hero__pill-dot"></span>
          <span>{{ section.settings.badge_text | default: 'New Collection 2026 • COD Available' }}</span>
        </div>

        <h1 class="hero__headline">
          {{ section.settings.headline | default: 'Smart Finds. <span>Better Everyday.</span>' }}
        </h1>

        <p class="hero__subheadline">
          {{ section.settings.subheadline | default: 'Discover innovative, problem-solving home utility and smart gadgets designed for modern Indian homes. Tested for durability, priced fairly.' }}
        </p>

        <div class="hero__cta-group">
          <a href="{{ section.settings.primary_cta_link | default: '/collections/gadgets' }}" class="btn btn--primary btn--lg">
            {{ section.settings.primary_cta_text | default: 'Shop Gadgets' }}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a href="{{ section.settings.secondary_cta_link | default: '/collections/home-organisation' }}" class="btn btn--outline" style="border-color: #FFFFFF; color: #FFFFFF;">
            {{ section.settings.secondary_cta_text | default: 'Shop Home Utility' }}
          </a>
        </div>

        <div class="hero__trust-strip">
          <div class="hero__trust-item">
            <span>⭐</span>
            <span><strong>4.8/5</strong> by 25,000+ Indian Homes</span>
          </div>
          <div class="hero__trust-item">
            <span>⚡</span>
            <span><strong>Same Day</strong> Dispatch</span>
          </div>
          <div class="hero__trust-item">
            <span>💵</span>
            <span><strong>Zero Risk</strong> Cash On Delivery</span>
          </div>
        </div>
      </div>

      <div class="hero__visual">
        <div class="hero__card-showcase">
          <div class="hero__floating-badge">🔥 Deal of the Week: 48% OFF</div>
          <div class="hero__featured-product">
            <div style="position: relative; overflow: hidden; border-radius: var(--radius-sm); margin-bottom: 12px; background: #f0f4f8;">
              <img
                src="https://images.unsplash.com/photo-1558317374-067fb5f30001?auto=format&fit=crop&w=600&q=80"
                alt="Mini Rechargeable Vacuum Cleaner"
                style="width: 100%; aspect-ratio: 4/3; object-fit: cover;"
                width="600"
                height="450"
              >
            </div>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 6px;">
              <div>
                <span style="font-size: 0.75rem; font-weight: 700; color: var(--color-accent); text-transform: uppercase;">Trending Bestseller</span>
                <h3 style="font-size: 1.1rem; font-weight: 800; color: var(--color-primary); margin-top: 2px;">Mini Rechargeable Vacuum</h3>
              </div>
              <div style="text-align: right;">
                <div style="font-size: 1.2rem; font-weight: 900; color: var(--color-primary);">₹1,299</div>
                <div style="font-size: 0.8rem; color: var(--color-text-muted); text-decoration: line-through;">₹2,499</div>
              </div>
            </div>
            <p style="font-size: 0.85rem; color: var(--color-text-muted); margin-bottom: 14px;">Wireless 6000Pa suction for keyboards, car interiors & sofa corners.</p>
            <button
              class="btn btn--primary btn--full btn--sm js-add-to-cart"
              data-id="mini-rechargeable-vacuum-cleaner-black"
              data-handle="mini-rechargeable-vacuum-cleaner"
              data-title="Mini Rechargeable Vacuum Cleaner"
              data-price="1299"
              data-variant="Matte Black"
              data-image="https://images.unsplash.com/photo-1558317374-067fb5f30001?auto=format&fit=crop&w=400&q=80"
            >
              ⚡ Quick Buy (COD Available)
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "New Collection 2026 • COD Available"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline (HTML allowed)",
      "default": "Smart Finds. <span>Better Everyday.</span>"
    },
    {
      "type": "textarea",
      "id": "subheadline",
      "label": "Subheadline",
      "default": "Discover innovative, problem-solving home utility and smart gadgets designed for modern Indian homes. Tested for durability, priced fairly."
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Primary CTA Label",
      "default": "Shop Gadgets"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Primary CTA Link",
      "default": "/collections/gadgets"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary CTA Label",
      "default": "Shop Home Utility"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Secondary CTA Link",
      "default": "/collections/home-organisation"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
