{% assign hero_prod = all_products[section.settings.featured_product] %}
{% assign hero_variant = hero_prod.selected_or_first_available_variant %}

<section class="hero-section" style="background: {{ section.settings.hero_bg }};">
  <div class="page-width">
    <div class="hero-grid">
      <div class="hero__content">
        <div class="hero__pill">
          <span class="hero__pill-dot"></span>
          <span>{{ section.settings.badge_text | default: 'Smart Household Utility • Curated for India' }}</span>
        </div>

        <h1 class="hero__headline">
          {{ section.settings.headline | default: 'Smart Finds. <span>Better Everyday.</span>' }}
        </h1>

        <p class="hero__subheadline">
          {{ section.settings.subheadline | default: 'Discover innovative, problem-solving home utility and smart gadgets designed for modern Indian homes. Tested for durability, priced fairly.' }}
        </p>

        <div class="hero__cta-group">
          <a href="{{ section.settings.primary_cta_link | default: routes.all_products_collection_url }}" class="btn btn--primary btn--lg">
            {{ section.settings.primary_cta_text | default: 'Explore Catalog' }}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a href="{{ section.settings.secondary_cta_link | default: routes.collections_url }}" class="btn btn--outline" style="border-color: #FFFFFF; color: #FFFFFF;">
            {{ section.settings.secondary_cta_text | default: 'View Categories' }}
          </a>
        </div>

        <div class="hero__trust-strip">
          <div class="hero__trust-item">
            <span>🛡️</span>
            <span><strong>Quality Tested</strong> Multi-Supplier Sourcing</span>
          </div>
          <div class="hero__trust-item">
            <span>⚡</span>
            <span><strong>Prompt Dispatch</strong> Across India</span>
          </div>
          <div class="hero__trust-item">
            <span>🔄</span>
            <span><strong>7-Day Replacement</strong> Support</span>
          </div>
        </div>
      </div>

      <div class="hero__visual">
        <div class="hero__card-showcase">
          <div class="hero__floating-badge">🔥 Featured Utility Find</div>
          <div class="hero__featured-product">
            <div style="position: relative; overflow: hidden; border-radius: var(--radius-sm); margin-bottom: 12px; background: #f0f4f8;">
              {% if hero_prod != blank and hero_prod.featured_image %}
                <img
                  src="{{ hero_prod.featured_image | image_url: width: 600 }}"
                  alt="{{ hero_prod.title | escape }}"
                  style="width: 100%; aspect-ratio: 4/3; object-fit: cover;"
                  width="600"
                  height="450"
                  loading="eager"
                >
              {% else %}
                <img
                  src="https://images.unsplash.com/photo-1558317374-067fb5f30001?auto=format&fit=crop&w=600&q=80"
                  alt="Mini Rechargeable Vacuum Cleaner"
                  style="width: 100%; aspect-ratio: 4/3; object-fit: cover;"
                  width="600"
                  height="450"
                  loading="eager"
                >
              {% endif %}
            </div>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 6px;">
              <div>
                <span style="font-size: 0.75rem; font-weight: 700; color: var(--color-accent); text-transform: uppercase;">Top Pick</span>
                <h3 style="font-size: 1.1rem; font-weight: 800; color: var(--color-primary); margin-top: 2px;">
                  {% if hero_prod != blank %}{{ hero_prod.title | truncate: 28 }}{% else %}Mini Rechargeable Vacuum{% endif %}
                </h3>
              </div>
              <div style="text-align: right;">
                <div style="font-size: 1.2rem; font-weight: 900; color: var(--color-primary);">
                  {% if hero_variant != blank %}{{ hero_variant.price | money }}{% else %}₹1,299{% endif %}
                </div>
                {% if hero_variant != blank and hero_variant.compare_at_price > hero_variant.price %}
                  <div style="font-size: 0.8rem; color: var(--color-text-muted); text-decoration: line-through;">
                    {{ hero_variant.compare_at_price | money }}
                  </div>
                {% endif %}
              </div>
            </div>
            <p style="font-size: 0.85rem; color: var(--color-text-muted); margin-bottom: 14px;">Compact problem-solver for keyboards, car interiors and sofa corners.</p>
            
            {% if hero_variant != blank and hero_variant.available %}
              <button
                type="button"
                class="btn btn--primary btn--full btn--sm js-add-to-cart"
                data-variant-id="{{ hero_variant.id }}"
                data-id="{{ hero_variant.id }}"
                data-quantity="1"
              >
                ⚡ Add to Cart ({{ hero_variant.price | money }})
              </button>
            {% elsif hero_prod != blank %}
              <button type="button" class="btn btn--primary btn--full btn--sm" disabled="disabled" style="opacity: 0.6; cursor: not-allowed;">
                Sold Out
              </button>
            {% else %}
              <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary btn--full btn--sm">
                Explore Best Sellers
              </a>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Smart Household Utility • Curated for India"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline (HTML allowed)",
      "default": "Smart Finds. <span>Better Everyday.</span>"
    },
    {
      "type": "textarea",
      "id": "subheadline",
      "label": "Subheadline",
      "default": "Discover innovative, problem-solving home utility and smart gadgets designed for modern Indian homes. Tested for durability, priced fairly."
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Primary CTA Label",
      "default": "Explore Catalog"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Primary CTA Link"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary CTA Label",
      "default": "View Categories"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Secondary CTA Link"
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Showcase Product Card"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
