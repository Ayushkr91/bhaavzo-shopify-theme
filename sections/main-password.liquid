<div class="password-card">
  <!-- Brand Header -->
  <div class="password-brand">
    <div class="password-logo">
      <span class="password-logo-text">Bhaav<span>zo</span></span>
    </div>
    <span class="password-tagline-badge">{{ section.settings.tagline | default: 'Sahi Bhaav. Smart Ghar.' }}</span>
  </div>

  <!-- Content Block -->
  <div class="password-content">
    <span class="password-badge">🚀 {{ section.settings.badge | default: 'Store Opening Soon' }}</span>
    <h1 class="password-heading">{{ section.settings.heading | default: 'Something Smart is Coming Soon' }}</h1>
    <p class="password-subheading">
      {{ section.settings.subheading | default: 'We are curating innovative, high-utility smart gadgets and home essentials for modern Indian homes. Tested for durability, priced fairly.' }}
    </p>

    <!-- Password Access Form -->
    <div class="password-form-wrapper">
      {% form 'storefront_password', class: 'password-form' %}
        {% if form.errors %}
          <div class="password-form-error" role="alert">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span>{{ form.errors | default_errors | strip_html }}</span>
          </div>
        {% endif %}

        <div class="password-input-group">
          <label for="Password" class="visually-hidden">Store Password</label>
          <input
            type="password"
            name="password"
            id="Password"
            class="password-input"
            placeholder="Enter store password to preview..."
            autocomplete="current-password"
            required
            autofocus
          >
          <button type="submit" name="commit" class="btn btn--primary password-btn">
            Enter Store &rarr;
          </button>
        </div>
      {% endform %}
    </div>

    <!-- Owner Admin Link -->
    <div class="password-owner-link">
      <span>Are you the store owner?</span>
      <a href="/admin" class="admin-login-link">Log in to Shopify Admin</a>
    </div>

    <!-- Trust Highlights -->
    <div class="password-trust-strip">
      <div class="password-trust-item">
        <span>🛡️</span>
        <span>Quality Tested</span>
      </div>
      <div class="password-trust-item">
        <span>⚡</span>
        <span>COD Available</span>
      </div>
      <div class="password-trust-item">
        <span>🔄</span>
        <span>7-Day Replacement</span>
      </div>
    </div>
  </div>
</div>

<style>
  .password-card {
    background: #FFFFFF;
    color: #102A43;
    max-width: 580px;
    width: 100%;
    border-radius: 20px;
    padding: 44px 36px;
    text-align: center;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
  }

  .password-brand {
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .password-logo-text {
    font-size: 2.2rem;
    font-weight: 900;
    color: #102A43;
    letter-spacing: -0.5px;
  }

  .password-logo-text span {
    color: #FF6B35;
  }

  .password-tagline-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: #486581;
    background: #F0F4F8;
    padding: 3px 10px;
    border-radius: 12px;
  }

  .password-badge {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    color: #FF6B35;
    background: #FFF0EB;
    padding: 6px 14px;
    border-radius: 20px;
    margin-bottom: 16px;
  }

  .password-heading {
    font-size: 1.85rem;
    font-weight: 800;
    color: #102A43;
    line-height: 1.25;
    margin: 0 0 12px;
  }

  .password-subheading {
    font-size: 0.95rem;
    color: #627D98;
    line-height: 1.5;
    margin: 0 0 28px;
  }

  .password-form-wrapper {
    margin-bottom: 20px;
  }

  .password-form-error {
    background: #FFEEEE;
    border: 1px solid #FFCDCD;
    color: #C53030;
    padding: 10px 14px;
    border-radius: 8px;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 0.85rem;
  }

  .password-input-group {
    display: flex;
    gap: 8px;
  }

  .password-input {
    flex: 1;
    height: 48px;
    padding: 0 16px;
    border: 2px solid #D9E2EC;
    border-radius: 10px;
    font-size: 0.95rem;
    color: #102A43;
    transition: border-color 0.2s ease;
  }

  .password-input:focus {
    border-color: #FF6B35;
    outline: none;
    box-shadow: 0 0 0 3px rgba(255, 107, 53, 0.15);
  }

  .password-btn {
    height: 48px;
    padding: 0 22px;
    white-space: nowrap;
  }

  .password-owner-link {
    font-size: 0.85rem;
    color: #829AB1;
    margin-bottom: 28px;
  }

  .admin-login-link {
    color: #FF6B35;
    text-decoration: underline;
    font-weight: 600;
    margin-left: 4px;
  }

  .admin-login-link:hover {
    color: #E85924;
  }

  .password-trust-strip {
    display: flex;
    justify-content: center;
    gap: 18px;
    padding-top: 20px;
    border-top: 1px solid #F0F4F8;
    font-size: 0.8rem;
    font-weight: 600;
    color: #486581;
    flex-wrap: wrap;
  }

  .password-trust-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  @media (max-width: 600px) {
    .password-card {
      padding: 32px 20px;
    }
    .password-heading {
      font-size: 1.5rem;
    }
    .password-input-group {
      flex-direction: column;
    }
    .password-btn {
      width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "Password Main",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Brand Tagline",
      "default": "Sahi Bhaav. Smart Ghar."
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Status Badge",
      "default": "Store Opening Soon"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Something Smart is Coming Soon"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "We are curating innovative, high-utility smart gadgets and home essentials for modern Indian homes. Tested for durability, priced fairly."
    }
  ]
}
{% endschema %}
