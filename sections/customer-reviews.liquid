<section class="reviews-section">
  <div class="page-width">
    <div class="section-header">
      <div class="section-tagline">{{ section.settings.tagline | default: 'Customer Feedback' }}</div>
      <h2 class="section-title">{{ section.settings.title | default: 'What Our Customers Say' }}</h2>
      <p class="section-subtitle">{{ section.settings.subtitle | default: 'Everyday feedback and experiences from Indian households using Bhaavzo products.' }}</p>
    </div>

    <div class="reviews-grid">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'review' %}
            <div class="review-card" {{ block.shopify_attributes }}>
              <div class="review-card__stars">
                ★★★★★
              </div>
              <p class="review-card__text">“{{ block.settings.comment }}”</p>
              <div class="review-card__author">
                <div class="author-info">
                  <span class="author-name">{{ block.settings.author_name }}</span>
                  <span class="author-city">{{ block.settings.city }} • {{ block.settings.product_bought }}</span>
                </div>
              </div>
            </div>
          {% when '@app' %}
            <div class="reviews-app-block" style="grid-column: 1 / -1;" {{ block.shopify_attributes }}>
              {% render block %}
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer Reviews",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Customer Feedback"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "What Our Customers Say"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Everyday feedback and experiences from Indian households using Bhaavzo products."
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "review",
      "name": "Customer Review",
      "settings": [
        {
          "type": "text",
          "id": "author_name",
          "label": "Author Name",
          "default": "Rohan Sharma"
        },
        {
          "type": "text",
          "id": "city",
          "label": "City",
          "default": "Bengaluru"
        },
        {
          "type": "text",
          "id": "product_bought",
          "label": "Product Name",
          "default": "Mini Rechargeable Vacuum"
        },
        {
          "type": "textarea",
          "id": "comment",
          "label": "Review Comment",
          "default": "Cleaned my laptop keyboard and car AC vents within 5 minutes. Good suction power and battery lasts several cleanups."
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "review",
        "settings": {
          "author_name": "Pooja Deshmukh",
          "city": "Pune",
          "product_bought": "Kitchen Chopper",
          "comment": "Cut my cooking prep time in half! The pull cord mechanism is smooth and sturdy."
        }
      },
      {
        "type": "review",
        "settings": {
          "author_name": "Arjun Mehta",
          "city": "Mumbai",
          "product_bought": "Motion Sensor LED",
          "comment": "Placed near hallway and bathroom. Turns on automatically at night when someone walks by."
        }
      },
      {
        "type": "review",
        "settings": {
          "author_name": "Sneha Reddy",
          "city": "Hyderabad",
          "product_bought": "Foldable Laptop Stand",
          "comment": "Saved my neck posture during long work-from-home hours. Solid build and convenient to carry."
        }
      }
    ]
  },
  "presets": [
    {
      "name": "Customer Reviews"
    }
  ]
}
{% endschema %}
