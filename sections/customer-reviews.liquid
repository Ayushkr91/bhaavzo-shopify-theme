<section class="reviews-section">
  <div class="page-width">
    <div class="section-header">
      <div class="section-tagline">{{ section.settings.tagline | default: 'Verified Buyer Feedback' }}</div>
      <h2 class="section-title">{{ section.settings.title | default: 'Loved by 25,000+ Smart Indian Homes' }}</h2>
      <p class="section-subtitle">{{ section.settings.subtitle | default: 'Real reviews from verified customers across Delhi, Mumbai, Bengaluru, Pune, and 200+ cities.' }}</p>
    </div>

    <div class="reviews-grid">
      {% for block in section.blocks %}
        <div class="review-card" {{ block.shopify_attributes }}>
          <div class="review-card__stars">
            ★★★★★
          </div>
          <p class="review-card__text">“{{ block.settings.comment }}”</p>
          <div class="review-card__author">
            <div class="author-info">
              <span class="author-name">{{ block.settings.author_name }}</span>
              <span class="author-city">{{ block.settings.city }} • Bought {{ block.settings.product_bought }}</span>
            </div>
            <div class="verified-buyer-pill">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              Verified
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer Reviews",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Verified Buyer Feedback"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Loved by 25,000+ Smart Indian Homes"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Real reviews from verified customers across Delhi, Mumbai, Bengaluru, Pune, and 200+ cities."
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Customer Review",
      "settings": [
        {
          "type": "text",
          "id": "author_name",
          "label": "Author Name",
          "default": "Rohan Sharma"
        },
        {
          "type": "text",
          "id": "city",
          "label": "City",
          "default": "Bengaluru"
        },
        {
          "type": "text",
          "id": "product_bought",
          "label": "Product Name",
          "default": "Mini Rechargeable Vacuum"
        },
        {
          "type": "textarea",
          "id": "comment",
          "label": "Review Comment",
          "default": "Cleaned my laptop keyboard and car AC vents within 5 minutes. Amazing suction power and battery lasts several cleanups!"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "review",
        "settings": {
          "author_name": "Pooja Deshmukh",
          "city": "Pune",
          "product_bought": "Kitchen Chopper",
          "comment": "Cut my cooking prep time in half! The pull cord mechanism is super smooth and sturdy. Delivered in 3 days with COD."
        }
      },
      {
        "type": "review",
        "settings": {
          "author_name": "Arjun Mehta",
          "city": "Mumbai",
          "product_bought": "Motion Sensor LED",
          "comment": "Placed two near my hallway and bathroom. Turns on automatically when I walk by at night. Super energy efficient and bright!"
        }
      },
      {
        "type": "review",
        "settings": {
          "author_name": "Sneha Reddy",
          "city": "Hyderabad",
          "product_bought": "Foldable Laptop Stand",
          "comment": "Saved my neck posture during long work-from-home hours. Solid aluminum build, feels like a ₹2,000 product bought for just ₹799."
        }
      }
    ]
  },
  "presets": [
    {
      "name": "Customer Reviews"
    }
  ]
}
{% endschema %}
