<div class="collection-page-wrapper">
  <div class="collection-hero">
    <div class="page-width">
      <h1 class="collection-hero__title">
        {% if search.performed %}
          Search Results: “{{ search.terms }}” ({{ search.results_count }})
        {% else %}
          Search Bhaavzo Store
        {% endif %}
      </h1>
      <p class="collection-hero__desc">Find smart problem-solvers across home utility, kitchen, and gadgets.</p>
      
      <div style="max-width: 540px; margin: 20px auto 0;">
        <form action="{{ routes.search_url }}" method="get" role="search" style="display: flex; gap: 8px;">
          <input
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="Search kitchen, gadgets & utility..."
            class="search-input"
            style="flex: 1; padding: 12px 16px; border-radius: 9999px; border: 1.5px solid var(--color-border); font-size: 0.95rem; outline: none; background: white;"
            aria-label="Search"
          >
          <button type="submit" class="btn btn--primary" style="padding: 10px 24px; border-radius: 9999px;">
            Search
          </button>
        </form>
      </div>
    </div>
  </div>

  <div class="page-width" style="padding-top: 32px; padding-bottom: 64px;">
    {% if search.performed %}
      {% paginate search.results by 12 %}
        {% if search.results_count > 0 %}
          <div class="product-grid collection-grid">
            {% for item in search.results %}
              {% if item.object_type == 'product' %}
                {% render 'product-card', product_card_product: item %}
              {% else %}
                <div class="static-page-card" style="padding: 20px; border: 1px solid var(--color-border); border-radius: 8px; background: white;">
                  <span class="badge" style="font-size: 0.72rem; text-transform: uppercase;">{{ item.object_type }}</span>
                  <h3 style="font-size: 1.1rem; margin-top: 8px;"><a href="{{ item.url }}" style="color: inherit; text-decoration: none;">{{ item.title }}</a></h3>
                  <p style="font-size: 0.88rem; color: var(--color-text-muted); margin-top: 6px;">{{ item.content | strip_html | truncate: 120 }}</p>
                </div>
              {% endif %}
            {% endfor %}
          </div>

          {% if paginate.pages > 1 %}
            <div style="text-align: center; margin-top: 40px;">
              {{ paginate | default_pagination }}
            </div>
          {% endif %}
        {% else %}
          <div style="text-align: center; padding: 60px 16px; color: var(--color-text-muted);">
            <div style="font-size: 3rem; margin-bottom: 12px;">🔍</div>
            <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--color-primary); margin-bottom: 8px;">No matching products found</h3>
            <p style="font-size: 0.95rem; max-width: 440px; margin: 0 auto 24px;">Check your spelling or browse our top categories for smart home problem-solvers.</p>
            <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">View All Products</a>
          </div>
        {% endif %}
      {% endpaginate %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Search Results",
  "settings": []
}
{% endschema %}
