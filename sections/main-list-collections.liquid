<div class="collection-page-wrapper">
  <div class="collection-hero">
    <div class="page-width">
      <h1 class="collection-hero__title">{{ section.settings.title | default: 'All Collections & Categories' }}</h1>
      <p class="collection-hero__desc">{{ section.settings.description | default: 'Explore curated departments engineered for modern Indian home utility and smart living.' }}</p>
    </div>
  </div>

  <div class="page-width" style="padding-top: 32px; padding-bottom: 64px;">
    <div class="category-grid">
      {% for collection in collections %}
        {% unless collection.handle == 'frontpage' %}
          <a href="{{ collection.url }}" class="category-card" style="text-decoration: none;">
            <div class="category-card__image-wrap">
              {% if collection.featured_image %}
                <img
                  src="{{ collection.featured_image | image_url: width: 400 }}"
                  alt="{{ collection.title | escape }}"
                  class="category-card__img"
                  loading="lazy"
                  width="400"
                  height="400"
                >
              {% elsif collection.products.first.featured_image %}
                <img
                  src="{{ collection.products.first.featured_image | image_url: width: 400 }}"
                  alt="{{ collection.title | escape }}"
                  class="category-card__img"
                  loading="lazy"
                  width="400"
                  height="400"
                >
              {% else %}
                <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #F1F5F9; font-size: 2rem;">
                  📦
                </div>
              {% endif %}
            </div>
            <div class="category-card__info">
              <h3 class="category-card__title">{{ collection.title }}</h3>
              <div class="category-card__count">{{ collection.all_products_count }} Products &rarr;</div>
            </div>
          </a>
        {% endunless %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collections List",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "All Collections & Categories"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Explore curated departments engineered for modern Indian home utility and smart living."
    }
  ]
}
{% endschema %}
