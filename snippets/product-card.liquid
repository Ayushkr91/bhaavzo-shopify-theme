{% comment %}
  Renders a product card
  Accepts:
  - product_card_product: {Object} Product Liquid object
  - show_quick_add: {Boolean}
{% endcomment %}

{% assign current_variant = product_card_product.selected_or_first_available_variant | default: product_card_product.variants.first %}

<div class="product-card" data-category="{{ product_card_product.type | default: 'Smart Utility' }}">
  <div class="product-card__media">
    <a href="{{ product_card_product.url }}">
      {% if product_card_product.featured_image %}
        <img
          src="{{ product_card_product.featured_image | image_url: width: 400 }}"
          alt="{{ product_card_product.featured_image.alt | default: product_card_product.title | escape }}"
          class="product-card__img"
          loading="lazy"
          width="400"
          height="400"
        >
      {% else %}
        <img
          src="https://images.unsplash.com/photo-1558317374-067fb5f30001?auto=format&fit=crop&w=400&q=80"
          alt="{{ product_card_product.title | default: 'Product' | escape }}"
          class="product-card__img"
          loading="lazy"
          width="400"
          height="400"
        >
      {% endif %}
    </a>
    <div class="product-card__badges">
      {% if product_card_product.compare_at_price > product_card_product.price %}
        {% assign savings = product_card_product.compare_at_price | minus: product_card_product.price | times: 100 | divided_by: product_card_product.compare_at_price %}
        <span class="badge badge--sale">{{ savings }}% OFF</span>
      {% endif %}
      {% if product_card_product.available == false %}
        <span class="badge badge--out-of-stock">Sold Out</span>
      {% endif %}
    </div>
  </div>

  <div class="product-card__info">
    <div class="product-card__category">{{ product_card_product.type | default: 'Smart Utility' }}</div>
    <h3 class="product-card__title">
      <a href="{{ product_card_product.url }}">{{ product_card_product.title }}</a>
    </h3>

    {% if product_card_product.metafields.reviews.rating.value != blank %}
      <div class="product-card__rating">
        <span>★ {{ product_card_product.metafields.reviews.rating.value | round: 1 }}</span>
        <span class="product-card__rating-count">({{ product_card_product.metafields.reviews.rating_count }})</span>
      </div>
    {% endif %}

    <div class="product-card__price-row">
      <span class="product-card__price">{{ product_card_product.price | money }}</span>
      {% if product_card_product.compare_at_price > product_card_product.price %}
        <span class="product-card__compare-price">{{ product_card_product.compare_at_price | money }}</span>
      {% endif %}
    </div>

    <div class="product-card__actions">
      {% if product_card_product.available %}
        <button
          type="button"
          class="btn-quick-add js-add-to-cart"
          data-variant-id="{{ current_variant.id }}"
          data-id="{{ current_variant.id }}"
          data-handle="{{ product_card_product.handle }}"
          data-quantity="1"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          Quick Add
        </button>
      {% else %}
        <button type="button" class="btn-quick-add" disabled="disabled" style="opacity: 0.6; cursor: not-allowed;">
          Sold Out
        </button>
      {% endif %}
    </div>
  </div>
</div>
