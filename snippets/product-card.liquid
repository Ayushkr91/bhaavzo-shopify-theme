{% comment %}
  Renders a product card
  Accepts:
  - product_card_product: {Object} Product Liquid object
  - show_quick_add: {Boolean}
{% endcomment %}

<div class="product-card" data-category="{{ product_card_product.category | default: 'Gadgets' }}" data-price="{{ product_card_product.price | divided_by: 100.0 }}" data-rating="{{ product_card_product.rating | default: 4.8 }}">
  <div class="product-card__media">
    <a href="{{ product_card_product.url }}">
      <img
        src="{{ product_card_product.featured_image | default: 'https://images.unsplash.com/photo-1558317374-067fb5f30001?auto=format&fit=crop&w=400&q=80' }}"
        alt="{{ product_card_product.title | escape }}"
        class="product-card__img"
        loading="lazy"
        width="400"
        height="400"
      >
    </a>
    <div class="product-card__badges">
      {% if product_card_product.compare_at_price > product_card_product.price %}
        {% assign savings = product_card_product.compare_at_price | minus: product_card_product.price | times: 100 | divided_by: product_card_product.compare_at_price %}
        <span class="badge badge--sale">{{ savings }}% OFF</span>
      {% endif %}
      {% if product_card_product.available == false %}
        <span class="badge badge--out-of-stock">Sold Out</span>
      {% endif %}
    </div>
  </div>

  <div class="product-card__info">
    <div class="product-card__category">{{ product_card_product.category | default: 'Smart Utility' }}</div>
    <h3 class="product-card__title">
      <a href="{{ product_card_product.url }}">{{ product_card_product.title }}</a>
    </h3>

    <div class="product-card__rating">
      <span>★ {{ product_card_product.rating | default: '4.8' }}</span>
      <span class="product-card__rating-count">({{ product_card_product.reviews_count | default: 840 }})</span>
    </div>

    <div class="product-card__price-row">
      <span class="product-card__price">₹{{ product_card_product.price | divided_by: 100.0 | round }}</span>
      {% if product_card_product.compare_at_price > product_card_product.price %}
        <span class="product-card__compare-price">₹{{ product_card_product.compare_at_price | divided_by: 100.0 | round }}</span>
      {% endif %}
    </div>

    <div class="product-card__actions">
      <button
        class="btn-quick-add js-add-to-cart"
        data-id="{{ product_card_product.id }}"
        data-handle="{{ product_card_product.handle }}"
        data-title="{{ product_card_product.title | escape }}"
        data-price="{{ product_card_product.price | divided_by: 100.0 | round }}"
        data-image="{{ product_card_product.featured_image }}"
        data-variant="{{ product_card_product.variants.first.title | default: 'Standard' }}"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
        Quick Add
      </button>
    </div>
  </div>
</div>
