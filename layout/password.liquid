<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_primary | default: '#102A43' }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <title>
      {{ page_title }}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% else %}
      <meta name="description" content="Bhaavzo - Sahi Bhaav. Smart Ghar. Smart home gadgets and everyday utility essentials coming soon.">
    {% endif %}

    <!-- CSS Assets -->
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}

    <style>
      :root {
        --color-primary: {{ settings.color_primary | default: '#102A43' }};
        --color-accent: {{ settings.color_accent | default: '#FF6B35' }};
        --color-bg: {{ settings.color_background | default: '#FFFBF5' }};
        --color-surface: {{ settings.color_surface | default: '#FFFFFF' }};
      }

      body.template-password {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background: linear-gradient(135deg, #102A43 0%, #0B1D30 100%);
        color: #FFFFFF;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        margin: 0;
        padding: 0;
      }

      .password-main-container {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
      }
    </style>
  </head>

  <body class="template-password">
    <main id="MainContent" class="password-main-container" role="main">
      {{ content_for_layout }}
    </main>

    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
